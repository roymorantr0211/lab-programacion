#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

int main() {
    string nombre;
    double consumo, tarifa, pagoConsumo, montoFijo = 10.00, total;
    string categoria;

    cout << "Ingrese el nombre del cliente: ";
    getline(cin, nombre);

    cout << "Ingrese el consumo de agua (m3): ";
    cin >> consumo;

    if (consumo <= 0) {
        cout << "Error: el consumo debe ser mayor que 0." << endl;
        return 0;
    }

    if (consumo <= 15) {
        tarifa = 1.20;
        categoria = "Consumo Minimo";
    }
    else if (consumo <= 35) {
        tarifa = 2.50;
        categoria = "Consumo Domestico";
    }
    else if (consumo <= 70) {
        tarifa = 4.00;
        categoria = "Consumo Comercial";
    }
    else {
        tarifa = 6.50;
        categoria = "Consumo Alto / Industrial";
    }

    pagoConsumo = consumo * tarifa;
    total = montoFijo + pagoConsumo;

    cout << fixed << setprecision(2);

    cout << "\n--- FACTURA DE AGUA POTABLE ---" << endl;
    cout << "Nombre del cliente: " << nombre << endl;
    cout << "Consumo: " << consumo << " m3" << endl;
    cout << "Valor por m3: Bs " << tarifa << endl;
    cout << "Monto fijo: Bs " << montoFijo << endl;
    cout << "Pago por consumo: Bs " << pagoConsumo << endl;
    cout << "Pago total: Bs " << total << endl;
    cout << "Categoria: " << categoria << endl;

    return 0;
}

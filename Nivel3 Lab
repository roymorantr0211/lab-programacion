#include <iostream>
#include <string>

using namespace std;

int main() {
    // Declaración de variables
    string nombre;
    int edad;
    string carrera;
    int semestre;
    float promedio; // Tipo de dato Real

    // Entrada de datos
    cout << "--- REGISTRO Y VERIFICACIÓN DE APROBACIÓN ---" << endl;
    cout << "Ingrese el nombre del estudiante: ";
    getline(cin, nombre);

    cout << "Ingrese la edad: ";
    cin >> edad;
    cin.ignore();

    cout << "Ingrese la carrera: ";
    getline(cin, carrera);

    cout << "Ingrese el semestre: ";
    cin >> semestre;

    cout << "Ingrese el promedio final: ";
    cin >> promedio;

    // Salida de datos
    cout << "\n--- DATOS REGISTRADOS ---" << endl;
    cout << "Nombre: " << nombre << endl;
    cout << "Edad: " << edad << endl;
    cout << "Carrera: " << carrera << endl;
    cout << "Semestre: " << semestre << endl;
    cout << "Promedio final: " << promedio << endl;

    // Verificación de aprobación (Regla: promedio >= 51 o la nota mínima requerida)
    if (promedio >= 51.0) {
        cout << "Resultado: El estudiante APROBO" << endl;
    } else {
        cout << "Resultado: El estudiante REPROBO" << endl;
    }

    return 0;
}

#include <iostream>
using namespace std;

int main() {
    long long numero, complemento = 0, multiplicador = 1;

    cout << "Ingrese un numero: ";
    cin >> numero;

    long long temp = numero;
    while (temp > 0) {
        int digito = temp % 10;
        int nuevoDigito = 9 - digito;
        complemento = complemento + (nuevoDigito * multiplicador);
        multiplicador *= 10;
        temp /= 10;

    cout << "El complemento a 9 de " << numero << " es: " << complemento << endl;

    return 0;

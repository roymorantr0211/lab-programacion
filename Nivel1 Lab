#include <iostream>
#include <string>

using namespace std;

int main() {
    // Declaración de variables
    string nombre;
    int edad;
    string carrera;
    int semestre;

    // Entrada de datos
    cout << "--- REGISTRO DE ESTUDIANTE ---" << endl;
    cout << "Ingrese el nombre del estudiante: ";
    getline(cin, nombre);

    cout << "Ingrese la edad: ";
    cin >> edad;
    cin.ignore(); // Limpiar el búfer para leer la siguiente cadena

    cout << "Ingrese la carrera: ";
    getline(cin, carrera);

    cout << "Ingrese el semestre: ";
    cin >> semestre;

    // Salida de datos
    cout << "\n--- DATOS REGISTRADOS ---" << endl;
    cout << "Nombre: " << nombre << endl;
    cout << "Edad: " << edad << endl;
    cout << "Carrera: " << carrera << endl;
    cout << "Semestre: " << semestre << endl;

    return 0;
}
